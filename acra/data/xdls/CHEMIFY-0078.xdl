<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="cartridge_mgso4"
      type="cartridge"
      chemical="mgso4" />
    <Component
      id="reactor"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
    <Component
      id="filter"
      type="filter" />
  </Hardware>

  <Reagents>
    <Reagent
      name="allyl alcohol"
      role="reagent" />
    <Reagent
      name="nacl"
      role="reagent" />
    <Reagent
      name="pTSA"
      role="reagent" />
    <Reagent
      name="pimelic acid"
      role="reagent" />
    <Reagent
      name="nahco3"
      role="reagent" />
    <Reagent
      name="toluene"
      role="reagent"
      use_for_cleaning="True" />
    <Reagent
      name="etoac"
      role="reagent" />
  </Reagents>

  <Procedure>
    <AddSolid
      vessel="reactor"
      reagent="pimelic acid"
      mass="6.4 g" />
    <AddSolid
      vessel="reactor"
      reagent="pTSA"
      mass="38 mg"
      stir="True"
      stir_speed="600 RPM" />
    <Add
      vessel="reactor"
      reagent="toluene"
      volume="40 mL" />
    <Add
      vessel="reactor"
      reagent="allyl alcohol"
      volume="8.2 mL"
      stir="True"
      priming_volume="1.5 mL" />
    <HeatChill
      vessel="reactor"
      temp="115 °C"
      stir="True"
      time="16 h" />
    <HeatChillToTemp
      vessel="reactor"
      temp="25 °C"
      stir="True"
      continue_heatchill = "False"
      active="False"/>
    <Repeat
      repeats="2">
      <Transfer
        from_vessel="reactor"
        to_vessel="separator"
        volume="all" />
      <Add
        vessel="reactor"
        reagent="etoac"
        volume="40 mL"
        priming_volume="0" />
    </Repeat>
    <Transfer
      from_vessel="reactor"
      to_vessel="separator"
      volume="all" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="nahco3"
      repeats="3" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="nacl"
      repeats="2" />
    <Transfer
      from_vessel="separator"
      to_vessel="rotavap"
      volume="150 mL"
      through="mgso4"
      move_speed="10.0"
      dispense_speed="10.0" />
    <Evaporate
      vessel="rotavap"
      temp="50 °C"
      pressure="20 mbar"
      time="1.5 h"
      mode="auto" />
    <Dry
      vessel="rotavap" />
  </Procedure>

</Synthesis>
