<?xdl version="1.0.0" ?>
<XDL>

<Synthesis>

  <Hardware>
    <Component
      id="reactor"
      type="jacketed filter" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="MgSO4"
      type="cartridge"
      chemical="MgSO4" />
    <Component
      id="separator"
      type="separator" />
    <Component
      id="Prenyl_bromide"
      type="Flask"
      chemical="Prenyl bormide" />
    <Component
      id="Sodium_methoxide"
      type="Flask"
      chemical="Sodium methoxide" />
  </Hardware>

  <Reagents>
    <Reagent
      name="Sodium methoxide"
      role="reagent" />
    <Reagent
      name="methanol"
      role="reagent" />
    <Reagent
      name="dimethyl malonate"
      role="reagent" />
    <Reagent
      name="3,3-dimethylallyl bromide"
      role="reagent" />
    <Reagent
      name="aq NaHCO3-brine"
      role="reagent" />
    <Reagent
      name="diethyl ether"
      role="reagent" />
    <Reagent
      name="argon"
      role="reagent" />
    <Reagent
      name="Prenyl bromide"
      role="reagent" />
    <Reagent
      name="water"
      role="reagent" />
  </Reagents>

  <Procedure>
    <Repeat
      repeats="2">
      <Add
        vessel="Sodium_methoxide"
        reagent="methanol"
        volume="3.5 mL" />
      <Add
        vessel="Sodium_methoxide"
        reagent="argon"
        volume="1.5 l"
        speed="100.0"
        move_speed="100.0"
        aspiration_speed="50.0"
        prime_n_times="0"
        priming_volume="0" />
      <Add
        vessel="reactor"
        reagent="Sodium methoxide"
        volume="10 mL"
        prime_n_times="0"
        priming_volume="0" />
    </Repeat>
    <Add
      vessel="reactor"
      reagent="dimethyl malonate"
      volume="2.321 mL"
      stir="True"
      aspiration_speed="2.0" />
    <HeatChill
      vessel="reactor"
      temp="25 °C"
      time="30 min"
      stir="True" />
    <Async
      pid="prepare_solution_on_the_fly">
      <Add
        vessel="Prenyl_bromide"
        reagent="methanol"
        volume="7.86 mL" />
      <Add
        vessel="Prenyl_bromide"
        reagent="argon"
        volume="50 mL"
        speed="50.0"
        move_speed="50.0"
        aspiration_speed="50.0"
        prime_n_times="0"
        priming_volume="0" />
    </Async>
    <HeatChillToTemp
      vessel="reactor"
      temp="0 °C"
      stir="True" />
    <Await
      pid="prepare_solution_on_the_fly" />
    <Add
      vessel="reactor"
      reagent="Prenyl bromide"
      volume="15 mL"
      time="30 min"
      stir="True"
      prime_n_times="0"
      priming_volume="0" />
    <Add
      vessel="Prenyl_bromide"
      reagent="methanol"
      volume="3 mL" />
    <Add
      vessel="Prenyl_bromide"
      reagent="argon"
      volume="10 mL"
      move_speed="50.0"
      aspiration_speed="50.0"
      prime_n_times="0"
      priming_volume="0" />
    <Add
      vessel="reactor"
      reagent="Prenyl bromide"
      volume="15 mL"
      stir="True"
      prime_n_times="0"
      priming_volume="0" />
    <HeatChill
      vessel="reactor"
      temp="2.5 °C"
      time="3 h"
      stir="True" />
    <Evaporate
      vessel="reactor"
      temp="45 °C"
      pressure="218 mbar"
      time="60 min"
      mode="auto" />
    <Repeat
      repeats="3">
      <Add
        vessel="reactor"
        reagent="diethyl ether"
        volume="22 mL"
        stir="True"
        prime_n_times="0" />
      <Stir
        vessel="reactor"
        time="5 min" />
      <Transfer
        from_vessel="reactor"
        to_vessel="separator"
        volume="40 mL" />
    </Repeat>
    <Add
      vessel="separator"
      reagent="water"
      volume="5 mL" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="top"
      solvent="aq NaHCO3-brine"
      through="MgSO4"
      solvent_volume="42 mL"
      waste_phase_to_vessel="separator" />
    <Separate
      purpose="extract"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="top"
      solvent="diethyl ether"
      through="MgSO4"
      solvent_volume="42 mL" />
    <Evaporate
      vessel="rotavap"
      temp="50 °C"
      pressure="218 mbar"
      time="30 min"
      mode="auto" />
    <Dry
      vessel="rotavap"
      time="30 min"
      temp="50 °C" />
  </Procedure>

</Synthesis>

</XDL>
